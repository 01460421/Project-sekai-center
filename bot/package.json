{
  "name": "sekai-center-bot",
  "version": "1.1.0",
  "private": true,
  "description": "SEKAI 資源中心 伺服器機器人：100 個娛樂與互動功能（占卜、性格測驗、小遊戲、社交、經濟、轉蛋、問答、社群工具）。可跑在 Cloudflare Workers（HTTP 互動）或任何容器（Gateway 完整版）",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/index.js",
    "register": "node scripts/register.js",
    "features": "node scripts/list-features.js",
    "test": "node --test test/*.test.mjs",
    "check": "for f in src/*.js src/core/*.js src/features/*.js src/content/*.js scripts/*.js; do node --check \"$f\" || exit 1; done",
    "dev:workers": "wrangler dev",
    "deploy:workers": "wrangler deploy",
    "build:workers": "wrangler deploy --dry-run --outdir=dist",
    "docker:build": "docker build -f Dockerfile -t sekai-center-bot ..",
    "docker:run": "docker run --rm -it --env-file .env -v sekai-bot-data:/data sekai-center-bot"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "wrangler": "^4.141.0"
  }
}
