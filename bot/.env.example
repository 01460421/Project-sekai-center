# 複製成 bot/.env 後填入（.env 已在 .gitignore）。容器版（src/index.js）與註冊腳本讀這個檔；
# Workers 版的機密改用 `wrangler secret put`（見 wrangler.toml 與 README）。
DISCORD_TOKEN=
APP_ID=
# Workers 版驗簽用：開發者後台 General Information 的 Public Key
DISCORD_PUBLIC_KEY=
# Workers 版 POST /register 用的自訂密鑰（隨便一串長亂數）
REGISTER_SECRET=
# 開發時只註冊到一個伺服器（立即生效）；正式全域註冊時留空
GUILD_ID=
# 容器版狀態檔（預設 bot/state/state.json；Docker 映像預設 /data/state.json）
STATE_FILE=
# 選用：AI（占卜／測驗結果的解讀、/chat 對話、@機器人 回話）。不填就關閉，其他功能不受影響
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# 每人每日次數上限：解讀／對話
AI_DAILY_PER_USER=10
AI_CHAT_DAILY_PER_USER=40
# 功能超過這麼多毫秒還沒回應就先告訴 Discord「稍等」（預設 2200）
DEFER_MS=
